---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageSection from "../components/PageSection.astro";

import DownloadIcon from "../icons/download.astro";
import { marked } from "marked";

import defaultMd from "../content/resume.md?raw";
import feMd from "../content/resume-fe.md?raw";

// Add new variants here as you create more resume-*.md files
const variants: Record<string, string> = {
    "front-end": feMd,
    "fe": feMd,
};

const aud = Astro.url.searchParams.get("aud") ?? "";
const raw = variants[aud] ?? defaultMd;
const md = marked.parse(raw) as string;
---

<BaseLayout title="Resume" currentPage="resume">
    <PageSection title="Resume">
        <div
            class="relative max-h-[calc(70vh-10rem)] lg:max-h-[calc(92vh-10rem)] overflow-y-auto
		mask-alpha mask-t-from-black mask-t-from-98% mask-t-to-transparent mt-[-6px] pt-[6px]
		mask-alpha mask-b-from-black mask-b-from-98% mask-b-to-transparent pb-6"
        >
            <!-- Download Button -->
            <div class="flex justify-center">
                <a
                    href="/resume.pdf"
                    download
                    class="absolute top-2 right-2 pl-1 pr-2 py-[2px] flex flex-row items-center bg-primary rounded-xs text-sm text-neutral-200 hover:bg-neutral-200 hover:text-primary hover:shadow-sm transition-all"
                >
                    <DownloadIcon size="1.3em" color="text-white" /><p>pdf</p>
                </a>
            </div>
            <article
                class="prose max-w-none prose-sm prose-sky dark:prose-yellow
                prose-p:leading-5 prose-ul:leading-5
                text-primary prose-strong:text-primary prose-headings:text-primary"
                set:html={md}
            />
        </div>
    </PageSection>
</BaseLayout>
