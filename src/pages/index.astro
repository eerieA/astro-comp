---
import BaseLayout from "../layouts/BaseLayout.astro";
import GalleryCanvas from "../components/GalleryCanvas.svelte";

import { projects } from "../content/arrays";
---

<BaseLayout title="Home" currentPage="home">
	<!-- Gallery fills the scrollable content area on wide screens; mobile fallback is inside GalleryCanvas -->
	<div class="h-full flex flex-col">
		<GalleryCanvas {projects} client:load />
	</div>
</BaseLayout>
