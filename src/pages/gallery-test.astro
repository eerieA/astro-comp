---
// Temporary test page for Phase 3 — remove after Phase 4 integration
import GalleryCanvas from "../components/GalleryCanvas.svelte";
import { projects } from "../content/arrays";
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Gallery Test</title>
        <style>
            body {
                margin: 0;
                background: #0a1520;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                min-height: 100vh;
                font-family: sans-serif;
                color: #e8e8f0;
            }
            h2 {
                margin-bottom: 1rem;
                font-size: 1rem;
                opacity: 0.5;
                letter-spacing: 0.1em;
            }
            .wrap {
                width: 100%;
                max-width: 900px;
                padding: 0 1rem;
            }
        </style>
    </head>
    <body>
        <div class="wrap">
            <h2>GALLERY — PHASE 3 TEST</h2>
            <GalleryCanvas {projects} client:load />
        </div>
    </body>
</html>
